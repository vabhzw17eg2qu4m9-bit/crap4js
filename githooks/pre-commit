#!/usr/bin/env bash
# crap4js pre-commit hook.
# Runs the tool on staged JS/MJS/CJS files and blocks the commit when the
# max CRAP exceeds the 8.0 threshold (tool exits 2). One-time enable:
#   git config core.hooksPath githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if ! command -v node >/dev/null 2>&1; then
  echo "warning: node not on PATH — skipping crap4js pre-commit check" >&2
  exit 0
fi
if [ ! -f src/cli.js ]; then
  echo "warning: src/cli.js not found — skipping crap4js pre-commit check" >&2
  exit 0
fi

mapfile -t files < <(git diff --cached --name-only --diff-filter=ACM -- '*.js' '*.mjs' '*.cjs')

if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

set +e
node src/cli.js --threshold 8.0 --coverage coverage/coverage-final.json "${files[@]}"
status=$?
set -e

if [ "$status" -eq 2 ]; then
  echo "❌ commit blocked: CRAP threshold exceeded (see report above)" >&2
  exit 1
fi
exit 0
